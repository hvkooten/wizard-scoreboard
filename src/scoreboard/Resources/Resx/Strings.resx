<?xml version="1.0" encoding="utf-8"?>
<root>
  <xsd:schema id="root" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string" />
              <xsd:attribute name="xml:space" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>

  <data name="Settings" xml:space="preserve"><value>Settings</value></data>
  <data name="Rules" xml:space="preserve"><value>Rules</value></data>
  <data name="Highscore" xml:space="preserve"><value>Highscore</value></data>
  <data name="Scoreboard" xml:space="preserve"><value>Scoreboard</value></data>
  <data name="StartGame" xml:space="preserve"><value>Start Game</value></data>
  <data name="EndGame" xml:space="preserve"><value>End Game</value></data>
  <data name="SelectLanguage" xml:space="preserve"><value>Select Language</value></data>
  <data name="Players" xml:space="preserve"><value>Players</value></data>
  <data name="CreatorGroup" xml:space="preserve"><value>Create Group</value></data>
  <data name="ShowRules" xml:space="preserve"><value>Game Rules</value></data>
</root>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <ApplicationTitle>WizardScoreboard</ApplicationTitle>
    <ApplicationDisplayVersion>2.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>10293</ApplicationVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Sign Debug and Release with the same keystore so switching configurations or republishing is an
       in-place update; a signature mismatch forces an uninstall, which wipes groups and settings.
       Set WIZARD_KEYSTORE_PATH, WIZARD_KEY_ALIAS and WIZARD_KEYSTORE_PASS; the password never lives in the repo. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(WIZARD_KEYSTORE_PATH)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(WIZARD_KEYSTORE_PATH)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(WIZARD_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:WIZARD_KEYSTORE_PASS</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:WIZARD_KEYSTORE_PASS</AndroidSigningKeyPass>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#10161d" BaseSize="256,256" />
  </ItemGroup>

  <ItemGroup>
    <MauiImage Remove="Resources\AppIcon\appicon.svg" />
    <MauiImage Remove="Resources\AppIcon\appiconfg.svg" />
  </ItemGroup>

  <ItemGroup>
    <MauiImage Include="Resources\Images\logo.svg" />
  </ItemGroup>

  <ItemGroup>
    <MauiImage Include="Resources\Splash\splash.svg" />
  </ItemGroup>

  <ItemGroup>
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
